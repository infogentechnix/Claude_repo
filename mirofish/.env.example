# Copy to mirofish/.env (gitignored) and fill in. setup.sh symlinks it to
# mirofish/app/.env, which is where MiroFish reads its config.
# In cloud sessions you can instead set these as environment secrets;
# MiroFish falls back to process environment variables when no .env exists.

# LLM API (any OpenAI-compatible endpoint)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Zep memory graph (free tier is enough to start): https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Optional "boost" LLM. Leave these out entirely if unused.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# Optional: backend port (default 5001)
# FLASK_PORT=5001
